FROM python:3.12-slim

WORKDIR /app

# Installer la librairie système manquante pour XGBoost
RUN apt-get update && apt-get install -y libgomp1 && rm -rf /var/lib/apt/lists/*

COPY api/pricing_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY models/pricing /app/models/pricing
COPY api/pricing_service /app/api/pricing_service
COPY api/shared /app/api/shared

EXPOSE 8002

CMD ["uvicorn", "api.pricing_service.main:app", "--host", "0.0.0.0", "--port", "8002"]

FROM python:3.11-slim

WORKDIR /app

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Code
COPY api/orchestrator /app/api/orchestrator
COPY api/shared /app/api/shared

EXPOSE 8000

CMD ["uvicorn", "api.orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000"]

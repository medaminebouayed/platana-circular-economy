{
    "openapi": "3.1.0",
    "info": {
        "title": "Platana Orchestrator",
        "version": "1.0.0"
    },
    "paths": {
        "/process": {
            "post": {
                "summary": "Process Product",
                "description": "Orchestration asynchrone du pipeline complet.",
                "operationId": "process_product_process_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductProcessRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductProcessResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/optimize-logistics": {
            "post": {
                "summary": "Optimize Logistics",
                "description": "Phase 3: Optimisation combinatoire avec Google OR-Tools.",
                "operationId": "optimize_logistics_optimize_logistics_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OptimizeLogisticsRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OptimizeLogisticsResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LogisticsProduct": {
                "properties": {
                    "product_id": {
                        "type": "string",
                        "title": "Product Id"
                    },
                    "profit": {
                        "type": "number",
                        "title": "Profit"
                    }
                },
                "type": "object",
                "required": [
                    "product_id",
                    "profit"
                ],
                "title": "LogisticsProduct"
            },
            "OptimizeLogisticsRequest": {
                "properties": {
                    "products": {
                        "items": {
                            "$ref": "#/components/schemas/LogisticsProduct"
                        },
                        "type": "array",
                        "title": "Products"
                    },
                    "workshop_capacity": {
                        "additionalProperties": {
                            "type": "integer"
                        },
                        "type": "object",
                        "title": "Workshop Capacity"
                    }
                },
                "type": "object",
                "required": [
                    "products",
                    "workshop_capacity"
                ],
                "title": "OptimizeLogisticsRequest"
            },
            "OptimizeLogisticsResponse": {
                "properties": {
                    "allocations": {
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array",
                        "title": "Allocations"
                    },
                    "total_expected_profit": {
                        "type": "number",
                        "title": "Total Expected Profit"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    }
                },
                "type": "object",
                "required": [
                    "allocations",
                    "total_expected_profit",
                    "status"
                ],
                "title": "OptimizeLogisticsResponse"
            },
            "ProductProcessRequest": {
                "properties": {
                    "brand": {
                        "type": "string",
                        "title": "Brand"
                    },
                    "model": {
                        "type": "string",
                        "title": "Model"
                    },
                    "year": {
                        "type": "integer",
                        "title": "Year"
                    },
                    "original_price": {
                        "type": "number",
                        "title": "Original Price",
                        "default": 800.0
                    },
                    "images": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Images"
                    }
                },
                "type": "object",
                "required": [
                    "brand",
                    "model",
                    "year",
                    "images"
                ],
                "title": "ProductProcessRequest"
            },
            "ProductProcessResponse": {
                "properties": {
                    "grade": {
                        "type": "string",
                        "title": "Grade"
                    },
                    "defects": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Defects"
                    },
                    "market_price": {
                        "type": "number",
                        "title": "Market Price"
                    },
                    "refurb_cost": {
                        "type": "number",
                        "title": "Refurb Cost"
                    },
                    "profit": {
                        "type": "number",
                        "title": "Profit"
                    },
                    "decision": {
                        "type": "string",
                        "title": "Decision"
                    }
                },
                "type": "object",
                "required": [
                    "grade",
                    "defects",
                    "market_price",
                    "refurb_cost",
                    "profit",
                    "decision"
                ],
                "title": "ProductProcessResponse"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
FROM python:3.11-slim

WORKDIR /app

# Dépendances système
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Code
COPY models/cv /app/models/cv
COPY api/cv_service /app/api/cv_service
COPY api/shared /app/api/shared

EXPOSE 8001

CMD ["uvicorn", "api.cv_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
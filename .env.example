# Platana - Environment Variables Template
# Copy this file to .env and fill in the values

# Dify AI
DIFY_API_URL=http://127.0.0.1/v1
DIFY_EVAL_API_KEY=your-dify-eval-api-key
DIFY_PUBLISH_API_KEY=your-dify-publish-api-key

# Shopify
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-shopify-token

# MongoDB
MONGO_URL=mongodb://mongodb:27017

# JWT (CHANGE THIS - use a strong 256-bit random secret)
JWT_SECRET=CHANGE_THIS_RANDOM_256BIT_SECRET_DO_NOT_USE_IN_PRODUCTION

# Service URLs (for Docker networking)
ORCHESTRATOR_URL=http://orchestrator:8000
CV_SERVICE_URL=http://cv-service:8001
PRICING_SERVICE_URL=http://pricing-service:8002

# MLOps and pricing cache (local development defaults)
MLFLOW_TRACKING_URI=http://localhost:8081/mlflow
MLFLOW_PRICING_EXPERIMENT=platana-pricing
MLFLOW_CV_EXPERIMENT=platana-cv-grading
MLFLOW_BACKBONE_EXPERIMENT=platana-cv-backbone
# Generate with: htpasswd -nbB admin 'a-long-random-password'
# Escape every $ as $$ only when writing directly in docker-compose.yaml.
MLFLOW_BASIC_AUTH_USERS='admin:$2y$12$replace_this_with_a_real_bcrypt_hash'
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=replace-with-the-same-long-random-password
# Comma-separated hostnames accepted by MLflow's host-header protection.
MLFLOW_ALLOWED_HOSTS=localhost,localhost:8081,localhost:5000,127.0.0.1,127.0.0.1:8081,127.0.0.1:5000
REDIS_URL=redis://localhost:6379/0
PRICING_CACHE_TTL_SECONDS=3600
PRICING_CACHE_SCHEMA_VERSION=v1

# CORS Allowed Origins (Comma-separated list of web origins allowed to access the APIs)
# E.g., for Docker production setup (port 8080) and local dev (port 4200)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200,http://127.0.0.1:4200,http://localhost,http://127.0.0.1

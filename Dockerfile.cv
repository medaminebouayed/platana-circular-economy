FROM python:3.12-slim

WORKDIR /app

# Dépendances système
# Python deps
COPY api/cv_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Code
COPY models/__init__.py /app/models/__init__.py
COPY models/artifacts.py /app/models/artifacts.py
COPY models/cv/__init__.py /app/models/cv/__init__.py
COPY models/cv/inference.py /app/models/cv/inference.py
COPY api/cv_service /app/api/cv_service
COPY api/shared /app/api/shared

EXPOSE 8001

CMD ["uvicorn", "api.cv_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
